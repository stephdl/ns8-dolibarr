# Started by dolibarr-app.service: catches up the database upgrade and the
# smarthost or user domain changes missed while the app was stopped
[Unit]
Description=Apply the NS8 settings to Dolibarr
After=dolibarr-app.service

[Service]
Type=oneshot
# The first start installs the database before the settings can be applied
TimeoutStartSec=20min
SyslogIdentifier=%N
ExecStart=runagent dolibarr-apply-config
