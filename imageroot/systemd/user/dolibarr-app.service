[Unit]
Description=Podman dolibarr-app.service
BindsTo=dolibarr.service
After=dolibarr.service mariadb-app.service
Wants=dolibarr-apply-config.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/dolibarr-app.pid %t/dolibarr-app.ctr-id
# Keep the previous ldap.env if the cluster cannot be reached at boot
ExecStartPre=-runagent discover-ldap
ExecStart=/usr/bin/podman run --conmon-pidfile %t/dolibarr-app.pid \
    --cidfile %t/dolibarr-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/dolibarr.pod-id --replace -d --name dolibarr-app \
    --volume dolibarr-documents:/var/www/documents:Z \
    --volume dolibarr-custom:/var/www/html/custom:Z \
    --volume %S/dolibarr/ns8-conf.php:/var/www/scripts/before-starting.d/10-ns8-conf.php:ro,z \
    --volume %S/dolibarr/ns8-apache.conf:/etc/apache2/conf-enabled/zz-ns8.conf:ro,z \
    --env NS8_POD_HOSTNAME=${TRAEFIK_HOST} \
    --env-file=%S/state/secrets/dolibarr.env \
    --env-file=%S/state/ldap.env \
    --env DOLI_DB_HOST=127.0.0.1 \
    --env DOLI_DB_HOST_PORT=3306 \
    --env DOLI_DB_NAME=dolibarr \
    --env DOLI_DB_USER=dolibarr \
    --env DOLI_ADMIN_LOGIN=admin \
    --env DOLI_URL_ROOT=https://${TRAEFIK_HOST} \
    --env DOLI_INSTALL_AUTO=1 \
    ${DOLIBARR_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/dolibarr-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/dolibarr-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/dolibarr-app.pid
Type=forking

[Install]
WantedBy=default.target
