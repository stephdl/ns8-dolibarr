[Unit]
Description=Podman mariadb-app.service
BindsTo=dolibarr.service
After=dolibarr.service
Before=dolibarr-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/mariadb-app.pid %t/mariadb-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/mariadb-app.pid \
    --cidfile %t/mariadb-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/dolibarr.pod-id --replace -d --name mariadb-app \
    --volume mysql-data:/var/lib/mysql/:Z \
    --env-file=%S/state/secrets/mariadb.env \
    --env MARIADB_DATABASE=dolibarr \
    --env MARIADB_USER=dolibarr \
    --env MARIADB_AUTO_UPGRADE=1 \
    ${MARIADB_IMAGE} \
    --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci
# ping succeeds as soon as the server answers, whatever the credentials: no password needed
ExecStartPost=/usr/bin/podman exec mariadb-app /bin/sh -c 'until mariadb-admin ping -h127.0.0.1 --protocol=tcp --skip-ssl --silent; do sleep 1; done'
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/mariadb-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/mariadb-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/mariadb-app.pid
Type=forking

[Install]
WantedBy=default.target
