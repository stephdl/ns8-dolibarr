[Unit]
Description=Synchronize Dolibarr users with the NS8 user domain
Requisite=dolibarr-app.service
After=dolibarr-app.service

[Service]
Type=oneshot
SyslogIdentifier=%N
ExecStart=runagent dolibarr-apply-config --sync
