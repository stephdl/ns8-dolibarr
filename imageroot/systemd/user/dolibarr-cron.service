[Unit]
Description=Run the Dolibarr scheduled jobs
Requisite=dolibarr-app.service
After=dolibarr-app.service

[Service]
Type=oneshot
SyslogIdentifier=%N
# The key comes from the container environment, never from the command line
ExecStart=/usr/bin/podman exec -u www-data -w /var/www/scripts/cron dolibarr-app \
    /bin/sh -c 'exec php cron_run_jobs.php "$$DOLI_CRON_KEY" admin'
