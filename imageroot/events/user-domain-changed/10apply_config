import os
import sys
import json
import agent

event = json.load(sys.stdin)

# "domain" is obsolete since core 3.16.0, newer events carry "domains"
if os.getenv('USER_DOMAIN') not in {event.get('domain')} | set(event.get('domains', [])):
    sys.exit(0)

agent.run_helper('runagent', 'dolibarr-apply-config').check_returncode()
