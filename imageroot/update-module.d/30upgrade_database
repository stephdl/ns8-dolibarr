exec 1>&2

# A stopped app runs the upgrade at its next start, from dolibarr-apply-config
if ! systemctl --user -q is-active dolibarr-app.service; then
    echo "dolibarr-app.service is not running, the database upgrade runs when it starts"
    exit 0
fi

exec runagent dolibarr-upgrade-database
