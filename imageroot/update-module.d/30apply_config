exec 1>&2

# Runs the database upgrade, then the settings. 20restart already started it with
# dolibarr-app: this waits for that run, or starts a new one
if systemctl --user -q is-active dolibarr-app.service; then
    systemctl --user start dolibarr-apply-config.service
else
    echo "dolibarr-app.service is not running, the database upgrade runs when it starts"
fi
