#!/bin/bash

#
# Copyright (C) 2026 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

# The image entrypoint migrates the database only when install.lock is missing,
# so the module runs the Dolibarr upgrade scripts itself, once per new version.
# Called by dolibarr-apply-config once Apache answers, so a stopped app catches up at start.

set -e

exec 1>&2

podman exec -i -u www-data dolibarr-app sh -s <<'EOS'
set -e
cd /var/www/html/install

db_version=$(php -r '
    define("NOREQUIREUSER", 1);
    define("NOREQUIRETRAN", 1);
    require "/var/www/html/master.inc.php";
    echo getDolGlobalString("MAIN_VERSION_LAST_UPGRADE", getDolGlobalString("MAIN_VERSION_LAST_INSTALL"));
')
if [ -z "${db_version}" ] || [ "${db_version}" = "${DOLI_VERSION}" ]; then
    echo "Dolibarr database version ${db_version:-unknown}, files ${DOLI_VERSION}: no upgrade needed"
    exit 0
fi

echo "Upgrading the Dolibarr database from ${db_version} to ${DOLI_VERSION}"
trap 'rm -f /var/www/documents/upgrade.unlock' EXIT
log=/var/www/documents/ns8-upgrade.log
: > "${log}"

# A single run across several majors applies only the first and the last migration files
steps=""
major=$((${db_version%%.*} + 1))
while [ "${major}" -lt "${DOLI_VERSION%%.*}" ]; do
    steps="${steps} ${major}.0.0"
    major=$((major + 1))
done
steps="${steps} ${DOLI_VERSION}"

from=${db_version}
for to in ${steps}; do
    for script in upgrade.php upgrade2.php step5.php; do
        # The scripts refuse to run while install.lock exists without this file, and each run deletes it
        touch /var/www/documents/upgrade.unlock
        # A locked script still exits with 0, so its refusal message is checked too
        if ! php "${script}" "${from}" "${to}" >> "${log}" 2>&1 || grep -q "pages have been disabled" "${log}"; then
            echo "Dolibarr ${script} from ${from} to ${to} failed, see documents/ns8-upgrade.log. The dump taken before the update is state/dolibarr-before-update.sql"
            exit 1
        fi
    done
    echo "Dolibarr database upgraded from ${from} to ${to}"
    from=${to}
done
EOS
