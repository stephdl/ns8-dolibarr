set -e

# The dump holds the password hashes and the encrypted LDAP and SMTP credentials
umask 077

if ! systemctl --user -q is-active mariadb-app.service; then
    exit 0
fi

podman exec mariadb-app sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" exec mariadb-dump -uroot \
        --databases dolibarr \
        --default-character-set=utf8mb4 \
        --skip-dump-date \
        --single-transaction \
        --quick \
        --routines \
        --add-drop-table' > dolibarr.sql
