import os
import sys
import json
import subprocess
import agent

if os.getenv("USER_DOMAIN", "") == "":
    agent.set_status("validation-failed")
    json.dump([{"field": "user_domain", "parameter": "user_domain", "value": "", "error": "user_domain_required"}],
              fp=sys.stdout)
    sys.exit(3)

# Called directly, not through the timer unit: the unit cannot hand its result back
proc = subprocess.run(["runagent", "dolibarr-apply-config", "--sync", "--report"], stdout=subprocess.PIPE, text=True)
if proc.returncode != 0:
    sys.exit(proc.returncode)
json.dump(json.loads(proc.stdout), fp=sys.stdout)
