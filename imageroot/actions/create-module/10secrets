import os
import secrets

os.makedirs("secrets", mode=0o700, exist_ok=True)

root_password = secrets.token_urlsafe(32)
db_password = secrets.token_urlsafe(32)

def write_secret(path, lines):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fp:
        fp.write("\n".join(lines) + "\n")

write_secret("secrets/mariadb.env", [
    f"MARIADB_ROOT_PASSWORD={root_password}",
    f"MARIADB_PASSWORD={db_password}",
])
write_secret("secrets/dolibarr.env", [
    f"DOLI_DB_PASSWORD={db_password}",
    # Replaced by the password chosen in configure-module before the route exists
    f"DOLI_ADMIN_PASSWORD={secrets.token_urlsafe(32)}",
    # Encrypts the LDAP and SMTP passwords in the database: keep it with the backup
    f"DOLI_INSTANCE_UNIQUE_ID={secrets.token_hex(16)}",
    f"DOLI_CRON_KEY={secrets.token_hex(16)}",
])

# Read by the app container, written by discover-ldap at each start
write_secret("ldap.env", [])
