import sys
import json
import agent

request = json.load(sys.stdin)

original_environment = request['environment']

for evar in [
        "TRAEFIK_HOST",
        "TRAEFIK_LETS_ENCRYPT",
        "USER_DOMAIN",
        "ADMIN_GROUP",
        "LDAP_SYNC",
        "MAIL_FROM",
        "DOLIBARR_LANGUAGE",
        "ADMIN_PASSWORD_SET",
    ]:
    agent.set_env(evar, original_environment.get(evar, ""))

agent.dump_env()
