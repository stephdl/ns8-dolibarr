{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure dolibarr",
    "$id": "http://nethserver.org/json-schema/task/input/dolibarr/configure-module",
    "description": "Configure dolibarr",
    "examples": [
        {
            "host": "dolibarr.domain.org",
            "lets_encrypt": true,
            "user_domain": "ad.domain.org",
            "admin_group": "Domain Admins",
            "ldap_sync": true,
            "mail_from": "dolibarr@domain.org",
            "language": "en_US",
            "admin_password": "Nethesis,1234"
        },
        {
            "host": "dolibarr.domain.org",
            "lets_encrypt": false,
            "user_domain": "",
            "admin_group": "",
            "ldap_sync": false,
            "mail_from": "",
            "language": "fr_FR"
        }
    ],
    "type": "object",
    "required": [
        "host",
        "lets_encrypt",
        "user_domain",
        "admin_group",
        "ldap_sync",
        "mail_from",
        "language"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the application, like 'dolibarr.domain.org'",
            "format": "hostname",
            "pattern": "\\."
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "user_domain": {
            "type": "string",
            "description": "NS8 user domain used for LDAP authentication. Empty for local accounts only."
        },
        "admin_group": {
            "type": "string",
            "description": "Group of the user domain whose members get the Dolibarr administrator flag. Empty for none."
        },
        "ldap_sync": {
            "type": "boolean",
            "description": "Create and update the Dolibarr users of the user domain at configuration and every day"
        },
        "mail_from": {
            "type": "string",
            "description": "Sender address of Dolibarr emails. Empty for noreply@<host>.",
            "anyOf": [
                {
                    "maxLength": 0
                },
                {
                    "format": "email"
                }
            ]
        },
        "language": {
            "type": "string",
            "description": "Default Dolibarr language. auto follows the browser.",
            "enum": [
                "auto",
                "en_US",
                "en_GB",
                "fr_FR",
                "it_IT",
                "de_DE",
                "es_ES",
                "pt_PT",
                "pt_BR",
                "eu_ES",
                "nl_NL"
            ]
        },
        "admin_password": {
            "type": "string",
            "description": "New password of the Dolibarr local 'admin' account. Omit to keep the current one.",
            "minLength": 8
        }
    }
}
