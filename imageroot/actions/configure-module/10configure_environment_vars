import json
import sys
import agent

data = json.load(sys.stdin)

agent.set_env("TRAEFIK_HOST", data["host"])
agent.set_env("TRAEFIK_LETS_ENCRYPT", data["lets_encrypt"])
agent.set_env("USER_DOMAIN", data["user_domain"])
agent.set_env("ADMIN_GROUP", data["admin_group"] if data["user_domain"] else "")
agent.set_env("LDAP_SYNC", data["ldap_sync"] and data["user_domain"] != "")
agent.set_env("MAIL_FROM", data["mail_from"])
agent.set_env("DOLIBARR_LANGUAGE", data["language"])
