import os
import re
import sys
import json
import agent

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)

password = data.get("admin_password")

# Without a first password the admin account keeps a random password nobody knows
# A password still pending in secrets/ is applied at the next Dolibarr start
if not password and os.getenv("ADMIN_PASSWORD_SET") != "True" and not os.path.exists("secrets/admin_password"):
    agent.set_status('validation-failed')
    json.dump([{'field': 'admin_password', 'parameter': 'admin_password', 'value': '', 'error': 'admin_password_required'}], fp=sys.stdout)
    sys.exit(2)

# Same rules as the NsPasswordInput strength meter in the UI
if password and not (
    len(password) >= 8
    and re.search(r"[a-z]", password)
    and re.search(r"[A-Z]", password)
    and re.search(r"[0-9]", password)
    and re.search(r"[^A-Za-z0-9]", password)
):
    agent.set_status('validation-failed')
    json.dump([{'field': 'admin_password', 'parameter': 'admin_password', 'value': '', 'error': 'admin_password_too_weak'}], fp=sys.stdout)
    sys.exit(2)
