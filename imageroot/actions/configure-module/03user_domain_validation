import os
import sys
import json
import agent
from agent.ldapproxy import Ldapproxy

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)

if data["user_domain"] and data["user_domain"] not in Ldapproxy().get_domains_list():
    agent.set_status('validation-failed')
    json.dump([{'field': 'user_domain', 'parameter': 'user_domain', 'value': data["user_domain"], 'error': 'user_domain_not_found'}], fp=sys.stdout)
    sys.exit(2)
