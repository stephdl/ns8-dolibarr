import os
import sys
import json

data = json.load(sys.stdin)

# The password is consumed and removed by dolibarr-apply-config
if data.get("admin_password"):
    fd = os.open("secrets/admin_password", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fp:
        fp.write(data["admin_password"])
